            lines {
              text: "                    1. \320\233\320\270\321\207\320\275\321\213\320\265 \320\274\320\265\321\201\321\202\320\276\320\270\320\274\320\265\320\275\320\270\321\217 (*\321\230\320\260, \321\202\320\270, \320\276\320\275, \320\274\320\270, \320\262\320\270, \320\276\320\275\320\270*) \321\207\320\260\321\201\321\202\320\276 \320\276\320\277\321\203\321\201\320\272\320\260\321\216\321\202\321\201\321\217, \321\202\320\260\320\272 \320\272\320\260\320\272 \320\276\320\272\320\276\320\275\321\207\320\260\320\275\320\270\320\265 \320\263\320\273\320\260\320\263\320\276\320\273\320\260 \320\276\320\264\320\275\320\276\320\267\320\275\320\260\321\207\320\275\320\276 \321\203\320\272\320\260\320\267\321\213\320\262\320\260\320\265\321\202 \320\275\320\260 \320\273\320\270\321\206\320\276."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    2. \320\232\321\200\320\260\321\202\320\272\320\270\320\265 \320\261\320\265\320\267\321\203\320\264\320\260\321\200\320\275\321\213\320\265 \321\201\320\262\321\217\320\267\320\272\320\270 (*\321\201\320\260\320\274, \321\201\320\270, \321\230\320\265, \321\201\320\274\320\276, \321\201\321\202\320\265, \321\201\321\203* \320\270 *\321\233\321\203, \321\233\320\265\321\210, \321\233\320\265*) \320\277\320\276\320\264\321\207\320\270\320\275\321\217\321\216\321\202\321\201\321\217 \321\201\321\202\321\200\320\276\320\263\320\276\320\274\321\203 \320\267\320\260\320\272\320\276\320\275\321\203 \320\262\321\202\320\276\321\200\320\276\320\263\320\276 \320\274\320\265\321\201\321\202\320\260 \320\262 \320\277\321\200\320\265\320\264\320\273\320\276\320\266\320\265\320\275\320\270\320\270 (\320\277\320\276\320\267\320\270\321\206\320\270\321\217 \321\215\320\275\320\272\320\273\320\270\321\202\320\270\320\272)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    3. \320\222\320\276\320\277\321\200\320\276\321\201 \321\201\321\202\321\200\320\276\320\270\321\202\321\201\321\217 \320\273\320\270\320\261\320\276 \321\207\320\265\321\200\320\265\320\267 \321\207\320\260\321\201\321\202\320\270\321\206\321\203 **\302\253\320\224\320\260 \320\273\320\270\302\273** (*\320\224\320\260 \320\273\320\270 \321\200\320\260\320\264\320\270\321\210?*), \320\273\320\270\320\261\320\276 \320\270\320\275\320\262\320\265\321\200\321\201\320\270\320\265\320\271 \321\201 \321\207\320\260\321\201\321\202\320\270\321\206\320\265\320\271 **\302\253\320\273\320\270\302\273** (*\320\240\320\260\320\264\320\270\321\210 \320\273\320\270?*)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    1. \320\233\320\270\321\207\320\275\321\213\320\265 \320\274\320\265\321\201\321\202\320\276\320\270\320\274\320\265\320\275\320\270\321\217 (*\321\230\320\260, \321\202\320\270, \320\276\320\275, \320\274\320\270, \320\262\320\270, \320\276\320\275\320\270*) \321\207\320\260\321\201\321\202\320\276 \320\276\320\277\321\203\321\201\320\272\320\260\321\216\321\202\321\201\321\217."
