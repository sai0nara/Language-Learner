\203 \320\262\320\276\320\264\320\265, \320\274\320\276\320\273\320\270\320\274 \320\262\320\260\321\201?\",\n            distractorsJson = \"[\\\"\320\274\320\276\321\200\320\260\321\202\320\270\\\", \\\"\320\267\320\275\320\260\321\202\320\270\\\", \\\"\321\202\321\200\320\265\320\261\320\260\321\202\320\270\\\", \\\"\320\274\320\276\320\266\320\265\320\274\320\276\\\"]\"\n        ),\n        VocabItemEntity(\n            id = \"v_3_3\", lessonId = \"lesson_3\",\n            targetWord = \"\321\205\321\202\320\265\321\202\320\270\", targetWordLatin = \"hteti\",\n            sourceTranslation = \"\321\205\320\276\321\202\320\265\321\202\321\214\", partOfSpeech = \"\320\234\320\276\320\264\320\260\320\273\321\214\320\275\321\213\320\271 \320\263\320\273\320\260\320\263\320\276\320\273\",\n            exampleSentence = \"\320\245\320\276\321\233\321\203 \320\264\320\260 \320\272\321\203\320\277\320\270\320\274 \320\276\320\262\321\203 \320\267\320\260\320\275\320\270\320\274\321\231\320\270\320\262\321\203 \320\272\321\232\320\270\320\263\321\203.\",\n            distractorsJson = \"[\\\"\320\266\320\265\320\273\320\265\321\202\320\270\\\", \\\"\320\262\320\276\320\273\320\265\321\202\320\270\\\", \\\"\321\202\321\200\320\260\320\266\320\270\321\202\320\270\\\", \\\"\320\275\320\265\321\233\321\203\\\"]\"\n        ),\n        VocabItemEntity(\n            id = \"v_3_4\", lessonId = \"lesson_3\",\n            targetWord = \"\321\201\320\274\320\265\321\202\320\270\", targetWordLatin = \"smeti\",\n            sourceTranslation = \"\321\201\320\274\320\265\321\202\321\214 / \321\200\320\260\320\267\321\200\320\265\321\210\320\265\320\275\320\276\", partOfSpeech = \"\320\234\320\276\320\264\320\260\320\273\321\214\320\275\321\213\320\271 \320\263\320\273\320\260\320\263\320\276\320\273\",\n            exampleSentence = \"\320\236\320\262\320\264\320\265 \320\275\320\265 \321\201\320\274\320\265\321\202\320\265 \320\264\320\260 \320\277\320\260\321\200\320\272\320\270\321\200\320\260\321\202\320\265 \320\260\321\203\321\202\320\276\320\274\320\276\320\261\320\270\320\273.\",\n            distractorsJson = \"[\\\"\320\274\320\276\321\233\320\270\\\", \\\"\320\274\320\276\321\200\320\260\321\202\320\270\\\", \\\"\321\202\321\200\320\265\320\261\320\260\321\202\320\270\\\", \\\"\321\201\320\274\320\265\320\274\\\"]\"\n        ),\n        VocabItemEntity(\n            id = \"v_3_5\", lessonId = \"lesson_3\",\n            targetWord = \"\321\201\320\260\321\201\321\202\320\260\320\275\320\260\320\272\", targetWordLatin = \"sastanak\",\n            sourceTranslation = \"\320\262\321\201\321\202\321\200\320\265\321\207\320\260 / \321\201\320\276\320\261\321\200\320\260\320\275\320\270\320\265\", partOfSpeech = \"\320\241\321\203\321\211\320\265\321\201\321\202\320\262\320\270\321\202\320\265\320\273\321\214\320\275\320\276\320\265\",\n            exampleSentence = \"\320\230\320\274\320\260\320\274\320\276 \320\262\320\260\320\266\320\260\320\275 \320\277\320\276\321\201\320\273\320\276\320\262\320\275\320\270 \321\201\320\260\321\201\321\202\320\260\320\275\320\260\320\272 \321\203 \320\277\320\276\320\264\320\275\320\265.\",\n            distractorsJson = \"[\\\"\321\200\320\260\320\267\320\263\320\276\320\262\320\276\321\200\\\", \\\"\320\277\321\200\320\265\320\264\320\260\320\262\320\260\321\232\320\265\\\", \\\"\320\264\320\276\320\263\320\276\320\262\320\276\321\200\\\", \\\"\321\201\320\260\321\201\321\202\320\260\320\275\321\206\320\270\\\"]\"\n        ),\n        VocabItemEntity(\n            id = \"v_3_6\", lessonId = \"lesson_3\",\n            targetWord = \"\320\276\320\264\320\274\320\260\321\205\", targetWordLatin = \"odmah\",\n            sourceTranslation = \"\321\201\320\265\320\271\321\207\320\260\321\201 \320\266\320\265 / \321\201\321\200\320\260\320\267\321\203\", partOfSpeech = \"\320\235\320\260\321\200\320\265\321\207\320\270\320\265\",\n            exampleSentence = \"\320\234\320\276\321\200\320\260\320\274\320\276 \320\276\320\264\320\274\320\260\321\205 \320\264\320\260 \320\277\320\276\320\267\320\276\320\262\320\265\320\274\320\276 \321\202\320\260\320\272\321\201\320\270.\",\n            distractorsJson = \"[\\\"\320\272\320\260\321\201\320\275\320\270\321\230\320\265\\\", \\\"\321\201\321\203\321\202\321\200\320\260\\\", \\\"\321\230\321\203\321\207\320\265\\\", \\\"\320\261\321\200\320\267\320\276\\\"]\"\n        )\n    )\n\n    fun getInitialGrammarGuides(): List<GrammarGuideEntity> {\n        val lesson1Matrix = ConjugationMatrixData(\n            verbInfinitive = \"\320\240\320\260\320\264\320\270\321\202\320\270\",\n            verbInfinitiveLatin = \"Raditi\",\n            verbTranslation = \"\320\240\320\260\320\261\320\276\321\202\320\260\321\202\321\214 / \320\224\320\265\320\273\320\260\321\202\321\214\",\n            aspect = \"\320\235\320\265\321\201\320\262\321\200\321\210\320\265\320\275\320\270 (Imperfective)\",\n            cells = listOf(\n                ConjugationCell(\n                    formType = \"Affirmative (+)\",\n                    tense = \"Past\",\n                    formula = \"\320\240\320\260\320\264\320\270\320\276/\320\240\320\260\320\264\320\270\320\273\320\260 \321\201\320\260\320\274 (ja)\",\n                    exampleSerbian = \"\320\210\320\260 \321\201\320\260\320\274 \321\230\321\203\321\207\320\265 \320\264\321\203\320\263\320\276 \321\200\320\260\320\264\320\270\320\276.\",\n                    exampleSerbianLatin = \"Ja sam ju\304\215e dugo radio.\",\n                    exampleRussian = \"\320\257 \320\262\321\207\320\265\321\200\320\260 \320\264\320\276\320\273\320\263\320\276 \321\200\320\260\320\261\320\276\321\202\320\260\320\273.\",\n                    notes = \"\320\255\320\275\320\272\320\273\320\270\321\202\320\270\320\272\320\260 \'\321\201\320\260\320\274\' \321\201\321\202\320\260\320\262\320\270\321\202\321\201\321\217 \321\201\321\200\320\260\320\267\321\203 \320\277\320\276\321\201\320\273\320\265 \321\203\320\264\320\260\321\200\320\275\320\276\320\263\320\276 \320\277\320\265\321\200\320\262\320\276\320\263\320\276 \321\201\320\273\320\276\320\262\320\260.\"\n                ),\n                ConjugationCell(\n                    formType = \"Affirmative (+)\",\n                    tense = \"Present\",\n                    formula = \"\320\240\320\260\320\264\320\270\320\274, \321\200\320\260\320\264\320\270\321\210, \321\200\320\260\320\264\320\270, \321\200\320\260\320\264\320\270\320\274\320\276, \321\200\320\260\320\264\320\270\321\202\320\265, \321\200\320\260\320\264\320\265\",\n                    exampleSerbian = \"\320\210\320\260 \321\200\320\260\320\264\320\270\320\274 \321\203 \320\276\320\262\320\276\321\230 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\321\230\320\270.\",\n                    exampleSerbianLatin = \"Ja radim u ovoj kompaniji.\",\n                    exampleRussian = \"\320\257 \321\200\320\260\320\261\320\276\321\202\320\260\321\216 \320\262 \321\215\321\202\320\276\320\271 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\320\270.\",\n                    notes = \"\320\223\320\273\320\260\320\263\320\276\320\273\321\213 \320\275\320\260 -\320\270\321\202\320\270 \320\262 \320\277\321\200\320\265\320\267\320\265\320\275\321\202\320\265 \320\270\320\274\320\265\321\216\321\202 \320\276\320\272\320\276\320\275\321\207\320\260\320\275\320\270\321\217 -\320\270\320\274, -\320\270\321\210, -\320\270...\"\n                ),\n                ConjugationCell(\n                    formType = \"Affirmative (+)\",\n                    tense = \"Future\",\n                    formula = \"\320\240\320\260\320\264\320\270\321\233\321\203 \320\270\320\273\320\270 \320\210\320\260 \321\233\321\203 \321\200\320\260\320\264\320\270\321\202\320\270\",\n                    exampleSerbian = \"\320\241\321\203\321\202\321\200\320\260 \321\233\321\203 \321\200\320\260\320\264\320\270\321\202\320\270 \320\276\320\264 \320\272\321\203\321\233\320\265.\",\n                    exampleSerbianLatin = \"Sutra \304\207u raditi od ku\304\207e.\",\n                    exampleRussian = \"\320\227\320\260\320\262\321\202\321\200\320\260 \321\217 \320\261\321\203\320\264\321\203 \321\200\320\260\320\261\320\276\321\202\320\260\321\202\321\214 \320\270\320\267 \320\264\320\276\320\274\320\260.\",\n                    notes = \"\320\225\321\201\320\273\320\270 \320\274\320\265\321\201\321\202\320\276\320\270\320\274\320\265\320\275\320\270\320\265 \320\276\320\277\321\203\321\211\320\265\320\275\320\276: \320\240\320\260\320\264\320\270\321\233\321\203. \320\225\321\201\320\273\320\270 \321\201\321\202\320\276\320\270\321\202 \320\262\320\277\320\265\321\200\320\265\320\264\320\270: \320\210\320\260 \321\233\321\203 \321\200\320\260\320\264\320\270\321\202\320\270.\"\n                ),\n                ConjugationCell(\n                    formType = \"Negative (-)\",\n                    tense = \"Past\",\n                    formula = \"\320\235\320\270\321\201\320\260\320\274 \321\200\320\260\320\264\320\270\320\276/\321\200\320\260\320\264\320\270\320\273\320\260\",\n                    exampleSerbian = \"\320\235\320\270\321\201\320\260\320\274 \321\200\320\260\320\264\320\270\320\276 \320\275\320\270\321\210\321\202\320\260 \320\273\320\276\321\210\320\265.\",\n                    exampleSerbianLatin = \"Nisam radio ni\305\241ta lo\305\241e.\",\n                    exampleRussian = \"\320\257 \320\275\320\265 \320\264\320\265\320\273\320\260\320\273 \320\275\320\270\321\207\320\265\320\263\320\276 \320\277\320\273\320\276\321\205\320\276\320\263\320\276.\",\n                    notes = \"\320\236\321\202\321\200\320\270\321\206\320\260\321\202\320\265\320\273\321\214\320\275\321\213\320\265 \321\204\320\276\321\200\320\274\321\213: \320\275\320\270\321\201\320\260\320\274, \320\275\320\270\321\201\320\270, \320\275\320\270\321\230\320\265, \320\275\320\270\321\201\320\274\320\276, \320\275\320\270\321\