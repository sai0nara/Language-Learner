  code_action {
    action_spec {
      create_file {
        instruction: "package com.example.data.local\n\nimport androidx.room.TypeConverter\nimport com.squareup.moshi.Moshi\nimport com.squareup.moshi.Types\n\nclass Converters {\n    private val moshi = Moshi.Builder().build()\n    private val stringListType = Types.newParameterizedType(List::class.java, String::class.java)\n    private val stringListAdapter = moshi.adapter<List<String>>(stringListType)\n\n    @TypeConverter\n    fun fromStringList(list: List<String>?): String {\n        return stringListAdapter.toJson(list ?: emptyList())\n    }\n\n    @TypeConverter\n    fun toStringList(json: String?): List<String> {\n        if (json.isNullOrBlank()) return emptyList()\n        return try {\n            stringListAdapter.fromJson(json) ?: emptyList()\n        } catch (_: Exception) {\n            emptyList()\n        }\n    }\n}\n"
        path {
          absolute_uri: "file:///app/src/main/java/com/example/data/local/Converters.kt"
        }
        overwrite: true
      }
    }
