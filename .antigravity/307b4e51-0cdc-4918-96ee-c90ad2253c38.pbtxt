  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/data/local/LessonDao.kt"
    end_line: 36
    content: "package com.example.data.local\n\nimport androidx.room.Dao\nimport androidx.room.Insert\nimport androidx.room.OnConflictStrategy\nimport androidx.room.Query\nimport androidx.room.Update\nimport com.example.data.model.LessonEntity\nimport kotlinx.coroutines.flow.Flow\n\n@Dao\ninterface LessonDao {\n    @Query(\"SELECT * FROM lessons ORDER BY orderIndex ASC\")\n    fun getAllLessons(): Flow<List<LessonEntity>>\n\n    @Query(\"SELECT * FROM lessons WHERE id = :id LIMIT 1\")\n    suspend fun getLessonById(id: String): LessonEntity?\n\n    @Insert(onConflict = OnConflictStrategy.REPLACE)\n    suspend fun insertLesson(lesson: LessonEntity)\n\n    @Insert(onConflict = OnConflictStrategy.REPLACE)\n    suspend fun insertLessons(lessons: List<LessonEntity>)\n\n    @Update\n    suspend fun updateLesson(lesson: LessonEntity)\n\n    @Query(\"UPDATE lessons SET isCompleted = :completed, masteryScore = :score WHERE id = :id\")\n    suspend fun updateMastery(id: String, completed: Boolean, score: Float)\n\n    @Query(\"DELETE FROM lessons WHERE id = :id\")\n    suspend fun deleteLesson(id: String)\n\n    @Query(\"DELETE FROM lessons\")\n    suspend fun clearAll()\n}\n"
    num_lines: 37
    num_bytes: 1124
    line_range_bytes: 1124
  }
}
