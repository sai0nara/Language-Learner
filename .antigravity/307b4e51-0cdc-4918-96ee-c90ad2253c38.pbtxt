      arguments_json: "{\"CodeContent\":\"package com.example.data.local\\n\\nimport android.content.Context\\nimport androidx.room.Database\\nimport androidx.room.Room\\nimport androidx.room.RoomDatabase\\nimport androidx.room.TypeConverters\\nimport com.example.data.model.GrammarGuideEntity\\nimport com.example.data.model.LessonEntity\\nimport com.example.data.model.SentenceEntity\\nimport com.example.data.model.SrsReviewEntity\\nimport com.example.data.model.VocabItemEntity\\n\\n@Database(\\n    entities = [\\n        LessonEntity::class,\\n        VocabItemEntity::class,\\n        GrammarGuideEntity::class,\\n        SentenceEntity::class,\\n        SrsReviewEntity::class\\n    ],\\n    version = 1,\\n    exportSchema = false\\n)\\n@TypeConverters(Converters::class)\\nabstract class AppDatabase : RoomDatabase() {\\n    abstract fun lessonDao(): LessonDao\\n    abstract fun vocabDao(): VocabDao\\n    abstract fun grammarDao(): GrammarDao\\n    abstract fun sentenceDao(): SentenceDao\\n    abstract fun srsDao(): SrsDao\\n\\n    companion object {\\n        @Volatile\\n        private var INSTANCE: AppDatabase? = null\\n\\n        fun getInstance(context: Context): AppDatabase {\\n            return INSTANCE ?: synchronized(this) {\\n                val instance = Room.databaseBuilder(\\n                    context.applicationContext,\\n                    AppDatabase::class.java,\\n                    \\\"language_learner.db\\\"\\n                ).fallbackToDestructiveMigration().build()\\n                INSTANCE = instance\\n                instance\\n            }\\n        }\\n    }\\n}\\n\",\"Description\":\"Room AppDatabase definition for Language Learner\",\"Overwrite\":true,\"TargetFile\":\"/app/src/main/java/com/example/data/local/AppDatabase.kt\",\"toolAction\":\"Writing AppDatabase.kt\",\"toolSummary\":\"Create AppDatabase\"}"
