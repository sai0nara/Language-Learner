              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    **\320\232\320\273\321\216\321\207\320\265\320\262\321\213\320\265 \320\276\321\202\320\273\320\270\321\207\320\270\321\217 \320\276\321\202 \321\200\321\203\321\201\321\201\320\272\320\276\320\263\320\276:**"
