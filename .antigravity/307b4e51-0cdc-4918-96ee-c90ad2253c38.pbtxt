            lines {
              text: "                    ### \320\221\320\260\320\267\320\276\320\262\320\260\321\217 \321\201\321\202\321\200\321\203\320\272\321\202\321\203\321\200\320\260 \321\201\320\265\321\200\320\261\321\201\320\272\320\276\320\263\320\276 \320\263\320\273\320\260\320\263\320\276\320\273\320\260 (\320\234\320\265\321\202\320\276\320\264 \320\237\320\276\320\273\320\270\320\263\320\273\320\276\321\202 16)"
