320\260\321\202\320\270\\\\\\\", \\\\\\\"\320\263\320\276\320\262\320\276\321\200\320\270\320\274\320\276\\\\\\\"]\\\"\\n        ),\\n        VocabItemEntity(\\n            id = \\\"v_1_3\\\", lessonId = \\\"lesson_1\\\",\\n            targetWord = \\\"\321\200\320\260\320\267\321\203\320\274\320\265\321\202\320\270\\\", targetWordLatin = \\\"razumeti\\\",\\n            sourceTranslation = \\\"\320\277\320\276\320\275\320\270\320\274\320\260\321\202\321\214\\\", partOfSpeech = \\\"\320\223\320\273\320\260\320\263\320\276\320\273\\\",\\n            exampleSentence = \\\"\320\241\320\262\320\265 \321\201\320\260\320\262\321\200\321\210\320\265\320\275\320\276 \321\200\320\260\320\267\321\203\320\274\320\265\320\274 \320\272\320\260\320\264 \320\277\321\200\320\270\321\207\320\260\321\202\320\265 \321\201\320\277\320\276\321\200\320\276.\\\",\\n            distractorsJson = \\\"[\\\\\\\"\320\274\320\270\321\201\320\273\320\270\321\202\320\270\\\\\\\", \\\\\\\"\320\267\320\275\320\260\321\202\320\270\\\\\\\", \\\\\\\"\321\207\321\203\321\202\320\270\\\\\\\", \\\\\\\"\321\200\320\260\320\267\321\203\320\274\320\265\\\\\\\"]\\\"\\n        ),\\n        VocabItemEntity(\\n            id = \\\"v_1_4\\\", lessonId = \\\"lesson_1\\\",\\n            targetWord = \\\"\320\277\320\270\321\202\320\260\321\232\320\265\\\", targetWordLatin = \\\"pitanje\\\",\\n            sourceTranslation = \\\"\320\262\320\276\320\277\321\200\320\276\321\201\\\", partOfSpeech = \\\"\320\241\321\203\321\211\320\265\321\201\321\202\320\262\320\270\321\202\320\265\320\273\321\214\320\275\320\276\320\265\\\",\\n            exampleSentence = \\\"\320\230\320\274\320\260\320\274 \321\230\320\265\320\264\320\275\320\276 \320\262\320\260\320\266\320\275\320\276 \320\277\320\270\321\202\320\260\321\232\320\265 \320\267\320\260 \320\277\321\200\320\276\321\204\320\265\321\201\320\276\321\200\320\260.\\\",\\n            distractorsJson = \\\"[\\\\\\\"\320\276\320\264\320\263\320\276\320\262\320\276\321\200\\