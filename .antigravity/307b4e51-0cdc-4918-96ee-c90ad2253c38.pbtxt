      thinking_signature: "\022\326\024\n\323\024\001i\024}\023\240\034\025\253,\370\347\022\202\350k\3508\301_/!%\327V\346\257#;1ZJ\314/\345\020\nYR\224\316\341\313\343\350\002\260\034\376Z\a\262uV\302Dd\024\177o\326k\002;\255+%\275\033\261\352\020\275\266\304\355\273}\b\367\277\202p\271\037/\272\2254\310k\245\361\314i\001Z\217\\L\363\t\003\270\304\026\245S\016\216\001\273\347\265\311]z\342\335\245\230\035\275\a\016B;\314\362C~\314\363\026?M\024\373L\024L~\241\332\vD\357\303R*\363\210\023m\335a\277\204\207\241\213\n\274\340\331\374\b\323\225\233\031\214\2465u~;\235z\233;\006?\320\320|U\223\374\362\322\322\213<\210E\342\232$\3231\001\277l\237 \020\026\t\204\363\274\261X\303a\250\340] \340=D\035/#\'WL\204od\246\366<o\214\322\205\236Q\000\017\254\006M\247\032Ta\031M\332\364\233\321F4\313\177\177A\030\031\305\262\000\335\244w\035> \037\241\255\205\360\214\r\231\001\360qb#\333\230I1O\370,\242\214U\ar\257\356V\345~#\247z\361\274\2071\313\fU\223\317\023\3309%\240\f\324\'\303\316.\376\232U\315\270\207\305\266)\002\314\375_\371\344\2555\200\302U\0174\351\"\324=\244\337\300&\355\355,\b\020\f\272>T\253\352\214[\323\222\202\320\003\353\224*\024\2525\220O\031\002\3620\005\250F\257\303HD\235\336\026Mow\230-],\262\347\304\344A\261yA\260\253\372w\"^*\222!\254\033\023\362\003\031\030\265\333\022Q\351*\312-\026N\263\245\231\347\004#\337\253t\021\311\v\364\273\300Y^\340\032W\377\224\275\267\'>\004\026\337\321\245)h\200\030\335$\250\310NW\372\330O\177\253Cnq\223)\237\211\003\230H\006~\265\002\256\2169O\327\255\214\n\227\321\215\332\252\373\312\377Q\203\214\033A\305\250b\374G\323\313\237)\206\"\246\022F\201m\030\035\244\317\265\341\301\246&\311\223+Q\027\330S\321\023\343\361\020\201\270\324\262\336\335\t\215\3569\362\037uqu\275\207\233\032m]\250xb\303\234\212Q\264\363\301\031\224jHo}r\220\v\001\356\227\277\364h\352r\326yVO\001\263v\331?\365tFL\2279$[\206[^\312\335H\226\223\274t\235\354\177\304W\313\217^\255QB\344Wt\216\255ti\374\031\260,\371\244\v8\313\347!x$\333\247\256\\\362\003\320w