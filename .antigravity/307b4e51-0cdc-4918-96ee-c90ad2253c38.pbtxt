  code_action {
    action_spec {
      create_file {
        instruction: "package com.example.data.importer\n\nimport android.util.Xml\nimport com.example.data.model.ConjugationCell\nimport com.example.data.model.ConjugationMatrixData\nimport com.example.data.model.GrammarGuideEntity\nimport com.example.data.model.LessonEntity\nimport com.example.data.model.SentenceEntity\nimport com.example.data.model.VocabItemEntity\nimport com.squareup.moshi.Moshi\nimport com.squareup.moshi.Types\nimport org.xmlpull.v1.XmlPullParser\nimport java.io.BufferedReader\nimport java.io.InputStream\nimport java.io.InputStreamReader\nimport java.io.StringReader\nimport java.util.UUID\n\ndata class ImportResult(\n    val lessons: List<LessonEntity> = emptyList(),\n    val vocabItems: List<VocabItemEntity> = emptyList(),\n    val grammarGuides: List<GrammarGuideEntity> = emptyList(),\n    val sentences: List<SentenceEntity> = emptyList(),\n    val message: String = \"\"\n)\n\nobject CurriculumImporter {\n    private val moshi = Moshi.Builder().build()\n\n    // ==========================================\n    // JSON PARSER\n    // ==========================================\n    fun parseJson(jsonString: String): ImportResult {\n        return try {\n            val genericMapAdapter = moshi.adapter<Map<String, Any>>(\n                Types.newParameterizedType(Map::class.java, String::class.java, Any::class.java)\n            )\n            val root = genericMapAdapter.fromJson(jsonString) ?: return ImportResult(message = \"Invalid JSON structure\")\n\n            val lessons = mutableListOf<LessonEntity>()\n            val vocabList = mutableListOf<VocabItemEntity>()\n            val grammarList = mutableListOf<GrammarGuideEntity>()\n            val sentenceList = mutableListOf<SentenceEntity>()\n\n            // Case 1: Full curriculum with lessons\n            val lessonsRaw = root[\"lessons\"] as? List<Map<String, Any>>\n            if (lessonsRaw != null) {\n                lessonsRaw.forEachIndexed { index, lessonMap ->\n                    val lessonId = (lessonMap[\"id\"] as? String) ?: \"lesson_${System.currentTimeMillis()}_$index\"\n                    val title = (lessonMap[\"title\"] as? String) ?: \"Custom Lesson ${index + 1}\"\n                    val subtitle = (lessonMap[\"subtitle\"] as? String) ?: \"\"\n                    val grammarFocus = (lessonMap[\"grammarFocus\"] as? String) ?: \"General\"\n                    val level = (lessonMap[\"level\"] as? String) ?: \"B1\"\n\n                    val vItems = (lessonMap[\"vocab\"] as? List<Map<String, Any>>)?.mapIndexed { vIdx, vMap ->\n                        val target = (vMap[\"targetWord\"] as? String) ?: \"\"\n                        val latin = (vMap[\"targetWordLatin\"] as? String) ?: \"\"\n                        val translation = (vMap[\"sourceTranslation\"] as? String) ?: \"\"\n                        val pos = (vMap[\"partOfSpeech\"] as? String) ?: \"Word\"\n                        val distractors = (vMap[\"distractors\"] as? List<String>) ?: emptyList()\n                        val audioUri = (vMap[\"audioUri\"] as? String) ?: \"\"\n\n                        VocabItemEntity(\n                            id = \"vocab_${lessonId}_$vIdx\",\n                            lessonId = lessonId,\n                            targetWord = target,\n                            targetWordLatin = latin,\n                            sourceTranslation = translation,\n                            partOfSpeech = pos,\n                            distractorsJson = moshi.adapter<List<String>>(\n                                Types.newParameterizedType(List::class.java, String::class.java)\n                            ).toJson(distractors),\n                            audioUri = audioUri\n                        )\n                    } ?: emptyList()\n\n                    val gGuideMap = lessonMap[\"grammar\"] as? Map<String, Any>\n                    if (gGuideMap != null) {\n                        val gTitle = (gGuideMap[\"title\"] as? String) ?: title\n                        val gExplanation = (gGuideMap[\"explanation\"] as? String) ?: \"\"\n                        val matrixRaw = gGuideMap[\"matrix\"] as? Map<String, Any>\n                        val matrixJson = if (matrixRaw != null) {\n                            moshi.adapter(Any::class.java).toJson(matrixRaw)\n                        } else \"{}\"\n\n                        grammarList.add(\n                            GrammarGuideEntity(\n                                id = \"grammar_$lessonId\",\n                                lessonId = lessonId,\n                                title = gTitle,\n                                summary = subtitle,\n                                explanationMarkdown = gExplanation,\n                                matrixJson = matrixJson\n                            )\n                        )\n                    }\n\n                    val sItems = (lessonMap[\"sentences\"] as? List<Map<String, Any>>)?.mapIndexed { sIdx, sMap ->\n                        val src = (sMap[\"sourceSentence\"] as? String) ?: \"\"\n                        val tgt = (sMap[\"targetSentence\"] as? String) ?: \"\"\n                        val tgtLatin = (sMap[\"targetSentenceLatin\"] as? String) ?: \"\"\n                        val tokens = (sMap[\"tokens\"] as? List<String>) ?: tgt.split(\" \")\n                        val distractors = (sMap[\"distractors\"] as? List<String>) ?: emptyList()\n                        val hint = (sMap[\"hint\"] as? String) ?: \"\"\n                        val audioUri = (sMap[\"audioUri\"] as? String) ?: \"\"\n\n                        val strListAdapter = moshi.adapter<List<String>>(\n                            Types.newParameterizedType(List::class.java, String::class.java)\n                        )\n\n                        SentenceEntity(\n                            id = \"sent_${lessonId}_$sIdx\",\n                            lessonId = lessonId,\n                            sourceSentence = src,\n                            targetSentence = tgt,\n                            targetSentenceLatin = tgtLatin,\n                            tokensJson = strListAdapter.toJson(tokens),\n                            distractorTokensJson = strListAdapter.toJson(distractors),\n                            grammarHint = hint,\n                            audioUri = audioUri\n                        )\n                    } ?: emptyList()\n\n                    vocabList.addAll(vItems)\n                    sentenceList.addAll(sItems)\n\n                    lessons.add(\n                        LessonEntity(\n                            id = lessonId,\n                            orderIndex = index + 1,\n                            title = title,\n                            subtitle = subtitle,\n                            grammarFocus = grammarFocus,\n                            level = level,\n                            vocabCount = vItems.size,\n                            sentenceCount = sItems.size\n                        )\n                    )\n                }\n            } else {\n                // Case 2: Direct list of vocabulary words in JSON\n                val vocabRaw = root[\"vocab\"] as? List<Map<String, Any>>\n                if (vocabRaw != null) {\n                    val defaultLessonId = \"imported_vocab_${System.currentTimeMillis()}\"\n                    val vItems = vocabRaw.mapIndexed { idx, vMap ->\n                        VocabItemEntity(\n                            id = \"vocab_${defaultLessonId}_$idx\",\n                            lessonId = defaultLessonId,\n                            targetWord = (vMap[\"targetWord\"] as? String) ?: \"\",\n                            targetWordLatin = (vMap[\"targetWordLatin\"] as? String) ?: \"\",\n                            sourceTranslation = (vMap[\"sourceTranslation\"] as? String) ?: \"\",\n                            partOfSpeech = (vMap[\"partOfSpeech\"] as? String) ?: \"Word\",\n                            audioUri = (vMap[\"audioUri\"] as? String) ?: \"\"\n                        )\n                    }\n                    val lesson = LessonEntity(\n                        id = defaultLessonId,\n                        orderIndex = 99,\n                        title = \"Imported Vocabulary\",\n                        subtitle = \"Imported via JSON\",\n                        grammarFocus = \"Vocabulary\",\n                        level = \"Custom\",\n                        vocabCount = vItems.size,\n                        sentenceCount = 0\n                    )\n                    return ImportResult(\n                        lessons = listOf(lesson),\n                        vocabItems = vItems,\n                        message = \"Imported ${vItems.size} vocabulary items successfully\"\n                    )\n                }\n            }\n\n            ImportResult(\n                lessons = lessons,\n                vocabItems = vocabList,\n                grammarGuides = grammarList,\n                sentences = sentenceList,\n                message = \"Imported ${lessons.size} lessons, ${vocabList.size} vocab words, and ${sentenceList.size} sentences.\"\n            )\n        } catch (e: Exception) {\n            ImportResult(message = \"JSON parse error: ${e.localizedMessage}\")\n        }\n    }\n\n    // ==========================================\n    // CSV PARSER\n    // ==========================================\n    fun parseCsv(csvContent: String): ImportResult {\n        return try {\n            val lines = csvContent.lines().filter { it.isNotBlank() }\n            if (lines.isEmpty()) return ImportResult(message = \"CSV file is empty\")\n\n            val delimiter = if (lines.first().contains(\";\")) \";\" else \",\"\n            val startIndex = if (lines.first().lowercase().contains(\"target\") || lines.first().lowercase().contains(\"serbian\")) 1 else 0\n\n            val lessonId = \"csv_lesson_${System.currentTimeMillis()}\"\n            val vocabList = mutableListOf<VocabItemEntity>()\n\n            for (i in startIndex until lines.size) {\n                val tokens = parseCsvLine(lines[i], delimiter)\n                if (tokens.isNotEmpty()) {\n                    val targetWord = tokens.getOrNull(0)?.trim() ?: continue\n                    if (targetWord.isBlank()) continue\n                    val latin = tokens.getOrNull(1)?.trim() ?: \"\"\n                    val translation = tokens.getOrNull(2)?.trim() ?: \"\"\n                    val pos = tokens.getOrNull(3)?.trim() ?: \"Word\"\n                    val example = tokens.getOrNull(4)?.trim() ?: \"\"\n                    val audioUri = tokens.getOrNull(5)?.trim() ?: \"\"\n\n                    vocabList.add(\n                        VocabItemEntity(\n                            id = \"csv_vocab_${vocabList.size}\",\n                            lessonId = lessonId,\n                            targetWord = targetWord,\n                            targetWordLatin = latin,\n                            sourceTranslation = translation,\n                            partOfSpeech = pos,\n                            exampleSentence = example,\n                            audioUri = audioUri\n                        )\n                    )\n                }\n            }\n\n            val lesson = LessonEntity(\n                id = lessonId,\n                orderIndex = 100,\n                title = \"Imported CSV Deck\",\n                subtitle = \"Imported ${vocabList.size} words\",\n                grammarFocus = \"Lexical Study\",\n                level = \"Custom\",\n                vocabCount = vocabList.size,\n                sentenceCount = 0\n            )\n\n            ImportResult(\n                lessons = listOf(lesson),\n                vocabItems = vocabList,\n                message = \"Imported CSV deck with ${vocabList.size} words.\"\n            )\n        } catch (e: Exception) {\n            ImportResult(message = \"CSV parse error: ${e.localizedMessage}\")\n        }\n    }\n\n    private fun parseCsvLine(line: String, delimiter: String): List<String> {\n        val tokens = mutableListOf<String>()\n        val sb = StringBuilder()\n        var inQuotes = false\n\n        for (ch in line) {\n            if (ch == \'\\\"\') {\n                inQuotes = !inQuotes\n            } else if (ch.toString() == delimiter && !inQuotes) {\n                tokens.add(sb.toString().trim())\n                sb.clear()\n            } else {\n                sb.append(ch)\n            }\n        }\n        tokens.add(sb.toString().trim())\n        return tokens\n    }\n\n    // ==========================================\n    // XML PARSER\n    // ==========================================\n    fun parseXml(xmlContent: String): ImportResult {\n        return try {\n            val parser = Xml.newPullParser()\n            parser.setInput(StringReader(xmlContent))\n\n            val lessons = mutableListOf<LessonEntity>()\n            val vocabList = mutableListOf<VocabItemEntity>()\n            val grammarList = mutableListOf<GrammarGuideEntity>()\n            val sentenceList = mutableListOf<SentenceEntity>()\n\n            var currentLessonId = \"\"\n            var currentLessonTitle = \"\"\n            var currentLessonOrder = 1\n            var eventType = parser.eventType\n\n            while (eventType != XmlPullParser.END_DOCUMENT) {\n                when (eventType) {\n                    XmlPullParser.START_TAG -> {\n                        when (parser.name.lowercase()) {\n                            \"lesson\" -> {\n                                currentLessonId = parser.getAttributeValue(null, \"id\") ?: \"xml_l_${System.currentTimeMillis()}\"\n                                currentLessonTitle = parser.getAttributeValue(null, \"title\") ?: \"Lesson $currentLessonOrder\"\n                                val focus = parser.getAttributeValue(null, \"grammarFocus\") ?: \"Grammar\"\n                                val level = parser.getAttributeValue(null, \"level\") ?: \"B1\"\n\n                                lessons.add(\n                                    LessonEntity(\n                                        id = currentLessonId,\n                                        orderIndex = currentLessonOrder++,\n                                        title = currentLessonTitle,\n                                        subtitle = \"Imported XML Lesson\",\n                                        grammarFocus = focus,\n                                        level = level\n                                    )\n                                )\n                            }\n                            \"vocab\" -> {\n                                if (currentLessonId.isNotEmpty()) {\n                                    val target = parser.getAttributeValue(null, \"target\") ?: \"\"\n                                    val latin = parser.getAttributeValue(null, \"latin\") ?: \"\"\n                                    val trans = parser.getAttributeValue(null, \"translation\") ?: \"\"\n                                    val pos = parser.getAttributeValue(null, \"pos\") ?: \"Word\"\n                                    val audio = parser.getAttributeValue(null, \"audio\") ?: \"\"\n\n                                    if (target.isNotBlank()) {\n                                        vocabList.add(\n                                            VocabItemEntity(\n                                                id = \"xml_v_${vocabList.size}\",\n                                                lessonId = currentLessonId,\n                                                targetWord = target,\n                                                targetWordLatin = latin,\n                                                sourceTranslation = trans,\n                                                partOfSpeech = pos,\n                                                audioUri = audio\n                                            )\n                                        )\n                                    }\n                                }\n                            }\n                            \"sentence\" -> {\n                                if (currentLessonId.isNotEmpty()) {\n                                    val src = parser.getAttributeValue(null, \"source\") ?: \"\"\n                                    val tgt = parser.getAttributeValue(null, \"target\") ?: \"\"\n                                    val latin = parser.getAttributeValue(null, \"latin\") ?: \"\"\n                                    val tokensRaw = parser.getAttributeValue(null, \"tokens\") ?: tgt\n                                    val distractorsRaw = parser.getAttributeValue(null, \"distractors\") ?: \"\"\n                                    val hint = parser.getAttributeValue(null, \"hint\") ?: \"\"\n                                    val audio = parser.getAttributeValue(null, \"audio\") ?: \"\"\n\n                                    val tokens = tokensRaw.split(\",\").map { it.trim() }\n                                    val distractors = distractorsRaw.split(\",\").map { it.trim() }.filter { it.isNotBlank() }\n\n                                    val strListAdapter = moshi.adapter<List<String>>(\n                                        Types.newParameterizedType(List::class.java, String::class.java)\n                                    )\n\n                                    sentenceList.add(\n                                        SentenceEntity(\n                                            id = \"xml_s_${sentenceList.size}\",\n                                            lessonId = currentLessonId,\n                                            sourceSentence = src,\n                                            targetSentence = tgt,\n                                            targetSentenceLatin = latin,\n                                            tokensJson = strListAdapter.toJson(tokens),\n                                            distractorTokensJson = strListAdapter.toJson(distractors),\n                                            grammarHint = hint,\n                                            audioUri = audio\n                                        )\n                                    )\n                                }\n                            }\n                        }\n                    }\n                }\n                eventType = parser.next()\n            }\n\n            ImportResult(\n                lessons = lessons,\n                vocabItems = vocabList,\n                grammarGuides = grammarList,\n                sentences = sentenceList,\n                message = \"Imported XML with ${lessons.size} lessons, ${vocabList.size} words, ${sentenceList.size} sentences.\"\n            )\n        } catch (e: Exception) {\n            ImportResult(message = \"XML parse error: ${e.localizedMessage}\")\n        }\n    }\n\n    // Helper reader\n    fun readStream(stream: InputStream): String {\n        return BufferedReader(InputStreamReader(stream)).use { it.readText() }\n    }\n\n    // Sample export templates\n    fun getSampleJsonTemplate(): String = \"\"\"{\n  \"lessons\": [\n    {\n      \"id\": \"lesson_custom_1\",\n      \"title\": \"\320\243\321\200\320\276\320\272: \320\234\320\276\320\264\320\260\320\273\321\214\320\275\321\213\320\265 \320\263\320\273\320\260\320\263\320\276\320\273\321\213 (\320\245\321\202\320\265\321\202\320\270 / \320\234\320\276\321\233\320\270)\",\n      \"subtitle\": \"\320\245\320\276\321\233\321\203 \320\264\320\260 \321\200\320\260\320\264\320\270\320\274 / \320\234\320\276\320\263\321\203 \320\264\320\260 \321\203\321\207\320\270\320\274\",\n      \"grammarFocus\": \"Modal Verbs + Da + Present\",\n      \"level\": \"B1\",\n      \"vocab\": [\n        {\n          \"targetWord\": \"\321\205\321\202\320\265\321\202\320\270\",\n          \"targetWordLatin\": \"hteti\",\n          \"sourceTranslation\": \"\321\205\320\276\321\202\320\265\321\202\321\214\",\n          \"partOfSpeech\": \"\320\223\320\273\320\260\320\263\320\276\320\273\",\n          \"distractors\": [\"\320\274\320\276\321\233\320\270\", \"\320\267\320\275\320\260\321\202\320\270\", \"\320\270\320\274\320\260\321\202\320\270\"],\n          \"audioUri\": \"\"\n        },\n        {\n          \"targetWord\": \"\320\274\320\276\321\233\320\270\",\n          \"targetWordLatin\": \"mo\304\207i\",\n          \"sourceTranslation\": \"\320\274\320\276\321\207\321\214\",\n          \"partOfSpeech\": \"\320\223\320\273\320\260\320\263\320\276\320\273\",\n          \"distractors\": [\"\321\205\321\202\320\265\321\202\320\270\", \"\320\274\320\276\321\200\320\260\321\202\320\270\", \"\320\261\320\270\321\202\320\270\"],\n          \"audioUri\": \"\"\n        }\n      ],\n      \"grammar\": {\n        \"title\": \"\320\232\320\276\320\275\321\201\321\202\321\200\321\203\320\272\321\206\320\270\321\217 \'\320\245\321\202\320\265\321\202\320\270 + \320\224\320\220 + \320\237\321\200\320\265\320\267\320\265\320\275\321\202\'\",\n        \"explanation\": \"\320\222 \321\201\320\265\321\200\320\261\321\201\320\272\320\276\320\274 \321\217\320\267\321\213\320\272\320\265 \320\270\320\275\321\204\320\270\320\275\320\270\321\202\320\270\320\262 \320\277\320\276\321\201\320\273\320\265 \320\274\320\276\320\264\320\260\320\273\321\214\320\275\321\213\321\205 \320\263\320\273\320\260\320\263\320\276\320\273\320\276\320\262 \321\207\320\260\321\201\321\202\320\276 \320\267\320\260\320\274\320\265\320\275\321\217\320\265\321\202\321\201\321\217 \321\201\320\276\321\216\320\267\320\276\320\274 \'\320\264\320\260\' \321\201 \320\273\320\270\321\207\320\275\320\276\320\271 \321\204\320\276\321\200\320\274\320\276\320\271 \320\275\320\260\321\201\321\202\320\276\321\217\321\211\320\265\320\263\320\276 \320\262\321\200\320\265\320\274\320\265\320\275\320\270: \320\245\320\276\321\233\321\203 \320\264\320\260 \321\200\320\260\320\264\320\270\320\274 (\320\257 \321\205\320\276\321\207\321\203 \321\200\320\260\320\261\320\276\321\202\320\260\321\202\321\214).\",\n        \"matrix\": {\n          \"verbInfinitive\": \"\320\245\321\202\320\265\321\202\320\270\",\n          \"verbInfinitiveLatin\": \"Hteti\",\n          \"verbTranslation\": \"\320\245\320\276\321\202\320\265\321\202\321\214\",\n          \"aspect\": \"Imperfective\",\n          \"cells\": [\n            {\n              \"formType\": \"Affirmative\",\n              \"tense\": \"Present\",\n              \"formula\": \"\321\205\320\276\321\233\321\203, \321\205\320\276\321\233\320\265\321\210, \321\205\320\276\321\233\320\265, \321\205\320\276\321\233\320\265\320\274\320\276, \321\205\320\276\321\233\320\265\321\202\320\265, \321\205\320\276\321\233\320\265\",\n              \"exampleSerbian\": \"\320\210\320\260 \321\205\320\276\321\233\321\203 \320\264\320\260 \321\203\321\207\320\270\320\274 \321\201\321\200\320\277\321\201\320\272\320\270 \321\230\320\265\320\267\320\270\320\272.\",\n              \"exampleRussian\": \"\320\257 \321\205\320\276\321\207\321\203 \321\203\321\207\320\270\321\202\321\214 \321\201\320\265\321\200\320\261\321\201\320\272\320\270\320\271 \321\217\320\267\321\213\320\272.\"\n            }\n          ]\n        }\n      },\n      \"sentences\": [\n        {\n          \"sourceSentence\": \"\320\257 \321\205\320\276\321\207\321\203 \320\263\320\276\320\262\320\276\321\200\320\270\321\202\321\214 \320\277\320\276-\321\201\320\265\321\200\320\261\321\201\320\272\320\270.\",\n          \"targetSentence\": \"\320\210\320\260 \321\205\320\276\321\233\321\203 \320\264\320\260 \320\263\320\276\320\262\320\276\321\200\320\270\320\274 \321\201\321\200\320\277\321\201\320\272\320\270.\",\n          \"targetSentenceLatin\": \"Ja ho\304\207u da govorim srpski.\",\n          \"tokens\": [\"\320\210\320\260\", \"\321\205\320\276\321\233\321\203\", \"\320\264\320\260\", \"\320\263\320\276\320\262\320\276\321\200\320\270\320\274\", \"\321\201\321\200\320\277\321\201\320\272\320\270.\"],\n          \"distractors\": [\"\320\275\320\265\321\233\321\203\", \"\320\274\320\276\320\263\321\203\", \"\321\200\320\260\320\264\320\270\320\274\"],\n          \"hint\": \"\320\230\321\201\320\277\320\276\320\273\321\214\320\267\321\203\320\271\321\202\320\265 \321\201\320\262\321\217\320\267\320\272\321\203 \'\321\205\320\276\321\233\321\203 \320\264\320\260 + \320\277\321\200\320\265\320\267\320\265\320\275\321\201\'\",\n          \"audioUri\": \"\"\n        }\n      ]\n    }\n  ]\n}\"\"\"\n\n    fun getSampleCsvTemplate(): String = \"\"\"targetWord,targetWordLatin,sourceTranslation,partOfSpeech,exampleSentence,audioUri\n\321\200\320\260\320\267\320\263\320\276\320\262\320\260\321\200\320\260\321\202\320\270,razgovarati,\321\200\320\260\320\267\320\263\320\276\320\262\320\260\321\200\320\270\320\262\320\260\321\202\321\214,\320\223\320\273\320\260\320\263\320\276\320\273,\320\222\320\276\320\273\320\270\320\274 \320\264\320\260 \321\200\320\260\320\267\320\263\320\276\320\262\320\260\321\200\320\260\320\274 \321\201\320\260 \321\202\320\276\320\261\320\276\320\274.,\n\320\277\321\203\321\202\320\276\320\262\320\260\321\202\320\270,putovati,\320\277\321\203\321\202\320\265\321\210\320\265\321\201\321\202\320\262\320\276\320\262\320\260\321\202\321\214,\320\223\320\273\320\260\320\263\320\276\320\273,\320\241\321\203\321\202\321\200\320\260 \320\277\321\203\321\202\321\203\321\230\320\265\320\274\320\276 \321\203 \320\221\320\265\320\276\320\263\321\200\320\260\320\264.,\n\320\262\320\265\320\266\320\261\320\260\321\202\320\270,ve\305\276bati,\321\202\321\200\320\265\320\275\320\270\321\200\320\276\320\262\320\260\321\202\321\214\321\201\321\217 / \321\203\320\277\321\200\320\260\320\266\320\275\321\217\321\202\321\214\321\201\321\217,\320\223\320\273\320\260\320\263\320\276\320\273,\320\241\320\262\320\260\320\272\320\276\320\263 \320\264\320\260\320\275\320\260 \320\262\320\265\320\266\320\261\320\260\320\274 \321\201\321\200\320\277\321\201\320\272\320\270.,\n\321\200\320\260\320\267\321\203\320\274\320\265\320\262\320\260\321\232\320\265,razumevanje,\320\277\320\276\320\275\320\270\320\274\320\260\320\275\320\270\320\265,\320\241\321\203\321\211\320\265\321\201\321\202\320\262\320\270\321\202\320\265\320\273\321\214\320\275\320\276\320\265,\320\240\320\260\320\267\321\203\320\274\320\265\320\262\320\260\321\232\320\265 \320\263\321\200\320\260\320\274\320\260\321\202\320\270\320\272\320\265 \321\230\320\265 \320\273\320\260\320\272\320\276.,\n\320\277\320\276\321\202\321\200\320\265\320\261\320\260\320\275,potreban,\320\275\321\203\320\266\320\275\321\213\320\271 / \320\275\320\265\320\276\320\261\321\205\320\276\320\264\320\270\320\274\321\213\320\271,\320\237\321\200\320\270\320\273\320\260\320\263\320\260\321\202\320\265\320\273\321\214\320\275\320\276\320\265,\320\240\320\265\321\207\320\275\320\270\320\272 \321\230\320\265 \320\262\321\200\320\273\320\276 \320\277\320\276\321\202\321\200\320\265\320\261\320\260\320\275.,\n\"\"\"\n\n    fun getSampleXmlTemplate(): String = \"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<curriculum>\n  <lesson id=\"xml_lesson_1\" title=\"\320\243\321\200\320\276\320\272 1: \320\221\321\203\320\264\321\203\321\211\320\265\320\265 \320\262\321\200\320\265\320\274\321\217\" grammarFocus=\"Futur I\" level=\"B1\">\n    <vocab target=\"\320\277\321\203\321\202\320\276\320\262\320\260\321\202\320\270\" latin=\"putovati\" translation=\"\320\277\321\203\321\202\320\265\321\210\320\265\321\201\321\202\320\262\320\276\320\262\320\260\321\202\321\214\" pos=\"\320\223\320\273\320\260\320\263\320\276\320\273\" audio=\"\" />\n    <vocab target=\"\320\272\321\203\320\277\320\276\320\262\320\260\321\202\320\270\" latin=\"kupovati\" translation=\"\320\277\320\276\320\272\321\203\320\277\320\260\321\202\321\214\" pos=\"\320\223\320\273\320\260\320\263\320\276\320\273\" audio=\"\" />\n    <sentence source=\"\320\234\321\213 \320\267\320\260\320\262\321\202\321\200\320\260 \320\261\321\203\320\264\320\265\320\274 \320\277\321\203\321\202\320\265\321\210\320\265\321\201\321\202\320\262\320\276\320\262\320\260\321\202\321\214.\" target=\"\320\234\320\270 \321\233\320\265\320\274\320\276 \321\201\321\203\321\202\321\200\320\260 \320\277\321\203\321\202\320\276\320\262\320\260\321\202\320\270.\" latin=\"Mi \304\207emo sutra putovati.\" tokens=\"\320\234\320\270,\321\233\320\265\320\274\320\276,\321\201\321\203\321\202\321\200\320\260,\320\277\321\203\321\202\320\276\320\262\320\260\321\202\320\270.\" distractors=\"\320\261\320\270\321\233\320\265\320\274\320\276,\321\230\320\265\321\201\321\202\320\265\" hint=\"\320\221\321\203\320\264\321\203\321\211\320\265\320\265 \320\262\321\200\320\265\320\274\321\217 Futur I\" audio=\"\" />\n  </lesson>\n</curriculum>\"\"\"\n}\n"
