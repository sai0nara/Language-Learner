        instruction: "package com.example.data.initial\n\nimport com.example.data.model.ConjugationCell\nimport com.example.data.model.ConjugationMatrixData\nimport com.example.data.model.GrammarGuideEntity\nimport com.example.data.model.LessonEntity\nimport com.example.data.model.SentenceEntity\nimport com.example.data.model.VocabItemEntity\nimport com.squareup.moshi.Moshi\n\nobject InitialCurriculumData {\n    private val moshi = Moshi.Builder().build()\n    private val matrixAdapter = moshi.adapter(ConjugationMatrixData::class.java)\n\n    fun getInitialLessons(): List<LessonEntity> = listOf(\n        LessonEntity(\n            id = \"lesson_1\",\n            orderIndex = 1,\n            title = \"\320\243\321\200\320\276\320\272 1: \320\237\321\200\320\265\320\267\320\265\320\275\321\202 \320\270 \320\221\320\260\320\267\320\276\320\262\320\260\321\217 \320\274\320\260\321\202\321\200\320\270\321\206\320\260 \320\263\320\273\320\260\320\263\320\276\320\273\320\260\",\n            subtitle = \"\320\223\320\273\320\260\320\263\320\276\320\273\321\213 \320\275\320\260 -\320\260\321\202\320\270, -\320\265\321\202\320\270, -\320\270\321\202\320\270. \320\234\320\276\320\264\320\265\320\273\321\214 3x3\",\n            grammarFocus = \"\320\237\321\200\320\265\320\267\320\265\320\275\321\202 / 3x3 \320\234\320\260\321\202\321\200\320\270\321\206\320\260\",\n            level = \"B1\",\n            vocabCount = 6,\n            sentenceCount = 4\n        ),\n        LessonEntity(\n            id = \"lesson_2\",\n            orderIndex = 2,\n            title = \"\320\243\321\200\320\276\320\272 2: \320\222\320\276\320\267\320\262\321\200\320\260\321\202\320\275\321\213\320\265 \320\263\320\273\320\260\320\263\320\276\320\273\321\213 \321\201 \321\207\320\260\321\201\321\202\320\270\321\206\320\265\320\271 \'\320\241\320\225\'\",\n            subtitle = \"\320\241\320\265\321\233\320\260\321\202\320\270 \321\201\320\265, \320\275\320\260\320\264\320\260\321\202\320\270 \321\201\320\265, \320\261\320\260\320\262\320\270\321\202\320\270 \321\201\320\265. \320\237\320\276\320\267\320\270\321\206\320\270\321\217 \321\215\320\275\320\272\320\273\320\270\321\202\320\270\320\272\",\n            grammarFocus = \"\320\237\320\276\320\262\321\200\320\260\321\202\320\275\320\270 \320\263\320\273\320\260\320\263\320\276\320\273\320\270 (\321\201\320\265)\",\n            level = \"B1\",\n            vocabCount = 6,\n            sentenceCount = 4\n        ),\n        LessonEntity(\n            id = \"lesson_3\",\n            orderIndex = 3,\n            title = \"\320\243\321\200\320\276\320\272 3: \320\234\320\276\320\264\320\260\320\273\321\214\320\275\321\213\320\265 \320\272\320\276\320\275\321\201\321\202\321\200\321\203\320\272\321\206\320\270\320\270 (\320\245\321\202\320\265\321\202\320\270 / \320\234\320\276\321\233\320\270 / \320\234\320\276\321\200\320\260\321\202\320\270)\",\n            subtitle = \"\320\227\320\260\320\274\320\265\320\275\320\260 \320\270\320\275\321\204\320\270\320\275\320\270\321\202\320\270\320\262\320\260 \321\201\320\276\321\216\320\267\320\276\320\274 \'\320\224\320\220 + \320\237\321\200\320\265\320\267\320\265\320\275\321\202\'\",\n            grammarFocus = \"\320\234\320\276\320\264\320\260\320\273\320\275\320\270 \320\263\320\273\320\260\320\263\320\276\320\273\320\270 + \320\224\320\220\",\n            level = \"B1\",\n            vocabCount = 6,\n            sentenceCount = 4\n        ),\n        LessonEntity(\n            id = \"lesson_4\",\n            orderIndex = 4,\n            title = \"\320\243\321\200\320\276\320\272 4: \320\237\321\200\320\276\321\210\320\265\320\264\321\210\320\265\320\265 \320\262\321\200\320\265\320\274\321\217 (\320\237\320\265\321\200\321\204\320\265\320\272\320\260\321\202)\",\n            subtitle = \"\320\222\321\201\320\277\320\276\320\274\320\276\320\263\320\260\321\202\320\265\320\273\321\214\320\275\321\213\320\271 \320\263\320\273\320\260\320\263\320\276\320\273 \'\320\261\320\270\321\202\320\270\' + \320\273-\321\204\320\276\321\200\320\274\320\260 \320\277\321\200\320\270\321\207\320\260\321\201\321\202\320\270\321\217\",\n            grammarFocus = \"\320\237\320\265\321\200\321\204\320\265\320\272\320\260\321\202 (\320\237\321\200\320\276\321\210\320\273\320\276 \320\262\321\200\320\265\320\274\320\265)\",\n            level = \"B1\",\n            vocabCount = 6,\n            sentenceCount = 4\n        ),\n        LessonEntity(\n            id = \"lesson_5\",\n            orderIndex = 5,\n            title = \"\320\243\321\200\320\276\320\272 5: \320\221\321\203\320\264\321\203\321\211\320\265\320\265 \320\262\321\200\320\265\320\274\321\217 I (\320\244\321\203\321\202\321\203\321\200 I)\",\n            subtitle = \"\320\232\321\200\320\260\321\202\320\272\320\270\320\265 \321\204\320\276\321\200\320\274\321\213 \320\263\320\273\320\260\320\263\320\276\320\273\320\260 \'\321\205\321\202\320\265\321\202\320\270\': \321\233\321\203, \321\233\320\265\321\210, \321\233\320\265 / \321\200\320\260\320\264\320\270\321\233\321\203 vs \321\233\321\203 \321\200\320\260\320\264\320\270\321\202\320\270\",\n            grammarFocus = \"\320\244\321\203\321\202\321\203\321\200 I (\320\221\321\203\320\264\321\203\321\233\320\265 \320\262\321\200\320\265\320\274\320\265)\",\n            level = \"B1\",\n            vocabCount = 6,\n            sentenceCount = 4\n        ),\n        LessonEntity(\n            id = \"lesson_6\",\n            orderIndex = 6,\n            title = \"\320\243\321\200\320\276\320\272 6: \320\222\320\270\320\264\320\276\320\262\321\213\320\265 \320\277\320\260\321\200\321\213 \320\263\320\273\320\260\320\263\320\276\320\273\320\276\320\262\",\n            subtitle = \"\320\241\320\262\321\200\321\210\320\265\320\275\320\270 \320\270 \320\275\320\265\321\201\320\262\321\200\321\210\320\265\320\275\320\270 \320\262\320\270\320\264 (\320\277\320\270\321\201\320\260\321\202\320\270/\320\275\320\260\320\277\320\270\3