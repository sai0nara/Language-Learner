            lines {
              text: "                    \320\222 \321\201\320\265\321\200\320\261\321\201\320\272\320\276\320\274 \321\217\320\267\321\213\320\272\320\265, \320\272\320\260\320\272 \320\270 \320\262 \320\264\321\200\321\203\320\263\320\270\321\205 \321\201\320\273\320\260\320\262\321\217\320\275\321\201\320\272\320\270\321\205 \321\217\320\267\321\213\320\272\320\260\321\205, \320\263\320\273\320\260\320\263\320\276\320\273 \320\274\320\265\320\275\321\217\320\265\321\202\321\201\321\217 \320\277\320\276 \320\273\320\270\321\206\320\260\320\274, \321\207\320\270\321\201\320\273\320\260\320\274 \320\270 \320\262\321\200\320\265\320\274\320\265\320\275\320\260\320\274."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    \320\222 \321\201\320\265\321\200\320\261\321\201\320\272\320\276\320\274 \321\217\320\267\321\213\320\272\320\265 \320\263\320\273\320\260\320\263\320\276\320\273 \321\201\320\277\321\200\321\217\320\263\320\260\320\265\321\202\321\201\321\217 \320\277\320\276 \320\273\320\270\321\206\320\260\320\274, \321\207\320\270\321\201\320\273\320\260\320\274 \320\270 \320\262\321\200\320\265\320\274\320\265\320\275\320\260\320\274."
