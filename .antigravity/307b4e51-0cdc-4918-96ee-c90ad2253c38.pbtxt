    content: "            )\n        }\n\n        when (selectedTabIndex) {\n            0 -> {\n                // Lessons Stream\n                Box(modifier = Modifier.fillMaxSize()) {\n                    LazyColumn(\n                        modifier = Modifier\n                            .fillMaxSize()\n                            .testTag(\"lesson_list\"),\n                        contentPadding = PaddingValues(horizontal = 16.dp, vertical = 12.dp),\n                        verticalArrangement = Arrangement.spacedBy(10.dp)\n                    ) {\n                        items(lessons, key = { it.id }) { lesson ->\n                            LessonStreamCard(\n                                lesson = lesson,\n                                onClick = {\n                                    viewModel.selectLesson(lesson)\n                                    onOpenLesson(lesson)\n                                }\n                            )\n                        }\n\n                        item {\n                            Spacer(modifier = Modifier.height(80.dp))\n                        }\n                    }\n\n                    // Floating Bottom \"\320\237\321\200\320\276\320\264\320\276\320\273\320\266\320\270\321\202\321\214 \321\203\321\200\320\276\320\272\" bar matching screenshot\n                    if (lessons.isNotEmpty()) {\n                        val active = lessons.firstOrNull { !it.isCompleted } ?: lessons.first()\n                        Box(\n                            modifier = Modifier\n                                .align(Alignment.BottomCenter)\n                                .fillMaxWidth()\n                                .background(MaterialTheme.colorScheme.surface.copy(alpha = 0.95f))\n                                .navigationBarsPadding()\n                                .padding(horizontal = 16.dp, vertical = 12.dp)\n                        ) {\n                            Button(\n                                onClick = {\n                                    viewModel.selectLesson(active)\n                                    onOpenLesson(active)\n                                },\n                                modifier = Modifier\n                                    .fillMaxWidth()\n                                    .height(52.dp)\n                                    .testTag(\"resume_active_lesson_button\"),\n                                colors = ButtonDefaults.buttonColors(\n                                    containerColor = MaterialTheme.colorScheme.primary\n                                ),\n                                shape = RoundedCornerShape(12.dp)\n                            ) {\n                                Icon(Icons.Default.PlayArrow, contentDescription = null)\n                                Spacer(modifier = Modifier.width(8.dp))\n                                Text(\n                                    text = \"\320\237\321\200\320\276\320\264\320\276\320\273\320\266\320\270\321\202\321\214: ${active.title}\",\n                                    style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Bold),\n                                    maxLines = 1,\n                                    overflow = TextOverflow.Ellipsis\n                                )\n                            }\n                        }\n                    }\n                }\n            }\n\n            1 -> {\n                // Spaced Repetition quick launcher\n                SpacedRepetitionLauncherTab(\n                    dueCount = dueCount,\n                    onStartReview = onOpenSrsReview\n                )\n            }\n\n            2 -> {\n                // Quick shortcut to Importer\n                QuickImporterTab(onOpenFullImporter = onOpenImportExport)\n            }\n        }\n    }\n}\n\n@Composable\nfun LessonStreamCard(\n    lesson: LessonEntity,\n    onClick: () -> Unit\n) {\n    Card(\n        modifier = Modifier\n            .fillMaxWidth()\n            .clip(RoundedCornerShape(14.dp))\n            .clickable(onClick = onClick)\n            .testTag(\"lesson_card_${lesson.id}\"),\n        colors = CardDefaults.cardColors(\n            containerColor = MaterialTheme.colorScheme.surfaceVariant\n        ),\n        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)\n    ) {\n        Row(\n            modifier = Modifier\n                .fillMaxWidth()\n                .padding(16.dp),\n            verticalAlignment = Alignment.CenterVertically\n        ) {\n            // Circular badge indicator (matching the 4.5 / checkmark badge from screenshots)\n            Box(\n                modifier = Modifier\n                    .size(46.dp)\n                    .clip(CircleShape)\n                    .background(\n                        if (lesson.isCompleted) SuccessEmerald else MaterialTheme.colorScheme.primary\n                    ),\n                contentAlignment = Alignment.Center\n            ) {\n                if (lesson.isCompleted) {\n                    Icon(\n                        imageVector = Icons.Default.Check,\n                        contentDescription = \"\320\243\321\200\320\276\320\272 \320\276\321\201\320\262\320\276\320\265\320\275\",\n                        tint = Color.White,"
