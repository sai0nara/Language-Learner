    content: "            }\n\n            Spacer(modifier = Modifier.weight(1f))\n\n            // Check Answer Button\n            Box(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .padding(horizontal = 20.dp, vertical = 12.dp)\n            ) {\n                Button(\n                    onClick = {\n                        val currentTarget = if (isLatin) currentSentence.targetSentenceLatin else currentSentence.targetSentence\n                        val userAssembly = placedTokens.joinToString(\" \").trim().lowercase().replace(\".\", \"\").replace(\"?\", \"\")\n                        val cleanTarget = currentTarget.trim().lowercase().replace(\".\", \"\").replace(\"?\", \"\")\n\n                        if (userAssembly == cleanTarget || placedTokens.joinToString(\" \") == currentSentence.targetSentence) {\n                            validationResult = true\n                            correctCount++\n                            feedbackMessage = \"\320\237\321\200\320\260\320\262\320\270\320\273\321\214\320\275\320\276!\"\n                            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\n                                vibrator?.vibrate(VibrationEffect.createOneShot(50, VibrationEffect.DEFAULT_AMPLITUDE))\n                            }\n                            viewModel.playAudio(currentTarget, currentSentence.audioUri, isTargetLanguage = true)\n\n                            scope.launch {\n                                delay(1200)\n                                if (currentIndex + 1 < sentenceQueue.size) {\n                                    currentIndex++\n                                    setupCurrentSentence(sentenceQueue[currentIndex])\n                                } else {\n                                    isFinished = true\n                                    viewModel.recordLessonMastery(lesson.id, 4.8f)\n                                }\n                            }\n                        } else {\n                            validationResult = false\n                            wrongCount++\n                            feedbackMessage = \"\320\237\321\200\320\260\320\262\320\270\320\273\321\214\320\275\321\213\320\271 \320\276\321\202\320\262\320\265\321\202: $currentTarget\"\n                            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\n                                vibrator?.vibrate(VibrationEffect.createOneShot(120, VibrationEffect.DEFAULT_AMPLITUDE))\n                            }\n                            // Re-insert into queue for later mastery\n                            sentenceQueue.add(currentSentence)\n                        }\n                    },\n                    enabled = placedTokens.isNotEmpty(),\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .height(50.dp)\n                        .testTag(\"check_answer_button\"),\n                    colors = ButtonDefaults.buttonColors(\n                        containerColor = if (validationResult == true) SuccessEmerald else MaterialTheme.colorScheme.primary\n                    ),\n                    shape = RoundedCornerShape(12.dp)\n                ) {\n                    Text(\n                        text = if (validationResult == true) \"\320\222\320\265\321\200\320\275\320\276!\" else \"\320\237\321\200\320\276\320\262\320\265\321\200\320\270\321\202\321\214 \320\276\321\202\320\262\320\265\321\202\",\n                        fontWeight = FontWeight.Bold,\n                        fontSize = 16.sp"
