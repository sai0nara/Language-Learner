      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"package com.example.data.model\\n\\nimport com.squareup.moshi.JsonClass\\n\\n@JsonClass(generateAdapter = true)\\ndata class ConjugationCell(\\n    val formType: String,      // \\\"Affirmative\\\", \\\"Negative\\\", \\\"Interrogative\\\"\\n    val tense: String,         // \\\"Past\\\", \\\"Present\\\", \\\"Future\\\"\\n    val formula: String,       // e.g. \\\"\320\210\320\260 \321\201\320\260\320\274 \321\200\320\260\320\264\320\270\320\276 / \321\200\320\260\320\264\320\270\320\273\320\260\\\"\\n    val exampleSerbian: String,// e.g. \\\"\320\210\320\260 \321\201\320\260\320\274 \321\230\321\203\321\207\320\265 \320\264\321\203\320\263\320\276 \321\200\320\260\320\264\320\270\320\276.\\\"\\n    val exampleSerbianLatin: String = \\\"\\\",\\n    val exampleRussian: String,// e.g. \\\"\320\257 \320\262\321\207\320\265\321\200\320\260 \320\264\320\276\320\273\320\263\320\276 \321\200\320\260\320\261\320\276\321\202\320\260\320\273.\\\"\\n    val notes: String = \\\"\\\"     // e.g. \\\"Past: \320\263\320\273\320\260\320\263\320\276\320\273 \'\320\261\320\270\321\202\320\270\' \321\203 \320\277\321\200\320\265\320\267\320\265\320\275\321\202\321\203 + \321\200\320\260\320\264\320\275\320\270 \320\263\320\273\320\260\320\263\320\276\320\273\321\201\320\272\320\270 \320\277\321\200\320\270\320\264\320\265\320\262\\\"\\n)\\n\\n@JsonClass(generateAdapter = true)\\ndata class ConjugationMatrixData(\\n    val verbInfinitive: String,      // \\\"\320\240\320\260\320\264\320\270\321\202\320\270\\\" (to work)\\n    val verbInfinitiveLatin: String, // \\\"Raditi\\\"\\n    val verbTranslation: String,     // \\\"\320\240\320\260\320\261\320\276\321\202\320\260\321\202\321\214\\\"\\n    val aspect: String = \\\"Imperfective\\\",\\n    val cells: List<ConjugationCell> // 9 cells for the 3x3 matrix\\n)\\n\",\"Description\":\"Grammar Matrix models for 3x3 Polyglot verb conjugation grids\",\"Overwrite\":true,\"TargetFile\":\"/app/src/main/java/com/example/data/model/GrammarMatrix.kt\",\"toolAction\":\"Creating GrammarMatrix data class\",\"toolSummary\":\"Create GrammarMatrix models\"}"
