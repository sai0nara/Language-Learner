            lines {
              text: "#### Database Entities & Relationships"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `LessonEntity`: `id`, `orderIndex`, `title`, `grammarFocus`, `level` (e.g. \"B1\"), `isCompleted`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `VocabItemEntity`: `id`, `lessonId`, `sourceWord`, `targetWord`, `phonetic`, `partOfSpeech`, `distractorsJson`, `audioUri`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GrammarGuideEntity`: `id`, `lessonId`, `title`, `explanationMarkdown`, `matrixJson` (3x3 grid data)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `SentenceEntity`: `id`, `lessonId`, `sourceSentence`, `targetSentence`, `tokensJson`, `distractorTokensJson`, `explanation`, `audioUri`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `SrsReviewItem`: `id`, `itemType` (VOCAB / SENTENCE), `referenceId`, `repetition`, `intervalDays`, `easeFactor`, `nextDueDate`, `lastGrade`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "#### Core Feature Plan"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Pre-populated B1 Serbian Curriculum**: Complete set of initial lessons with authentic Serbian verb conjugations, reflexive verbs, question structures, vocabulary sets, and sentence construction challenges."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Grammar Matrix Interactive Viewer**: 3x3 layout with cells for affirmative, negative, interrogative across past, present, and future, with pronoun selectors (*\321\230\320\260, \321\202\320\270, \320\276\320\275/\320\276\320\275\320\260/\320\276\320\275\320\276, \320\274\320\270, \320\262\320\270, \320\276\320\275\320\270/\320\276\320\275\320\265*)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Practice Engines**: High-speed vocabulary matching drills and tile-unscrambling sentence assembly."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Import/Export Utility**: Export sample CSV, JSON, and XML templates; import external files with live validation and error reporting."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Spaced Repetition Review**: Smart review tab grouping overdue cards with grading options (Again, Hard, Good, Easy)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Dual Audio Support**: Text-to-Speech speaking Serbian/target languages with playback controls, plus custom audio URI playback via Android `MediaPlayer`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///.aistudio/artifacts/brain/307b4e51-0cdc-4918-96ee-c90ad2253c38/implementation_plan.md"
