    content: "                            false -> ErrorCoral\n                            else -> MaterialTheme.colorScheme.outline.copy(alpha = 0.3f)\n                        },\n                        RoundedCornerShape(14.dp)\n                    )\n                    .padding(14.dp)\n                    .testTag(\"assembly_bay\")\n            ) {\n                if (placedTokens.isEmpty()) {\n                    Text(\n                        text = \"\320\235\320\260\320\266\320\270\320\274\320\260\320\271\321\202\320\265 \320\275\320\260 \321\201\320\273\320\276\320\262\320\260 \320\275\320\270\320\266\320\265 \320\264\320\273\321\217 \321\201\320\276\321\201\321\202\320\260\320\262\320\273\320\265\320\275\320\270\321\217 \321\204\321\200\320\260\320\267\321\213...\",\n                        style = MaterialTheme.typography.bodyMedium,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.6f)\n                    )\n                } else {\n                    FlowRow(\n                        horizontalArrangement = Arrangement.spacedBy(8.dp),\n                        verticalArrangement = Arrangement.spacedBy(8.dp)\n                    ) {\n                        placedTokens.forEachIndexed { index, token ->\n                            WordChip(\n                                text = token,\n                                isPlaced = true,\n                                onClick = {\n                                    placedTokens.removeAt(index)\n                                    poolTokens.add(token)\n                                    validationResult = null\n                                    feedbackMessage = \"\"\n                                },\n                                testTag = \"placed_chip_$token\"\n                            )\n                        }\n                    }\n                }\n            }\n\n            // Feedback Message on check\n            AnimatedVisibility(visible = feedbackMessage.isNotBlank()) {\n                Box(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .padding(horizontal = 20.dp, vertical = 8.dp)\n                ) {\n                    Text(\n                        text = feedbackMessage,\n                        style = MaterialTheme.typography.bodySmall.copy(fontWeight = FontWeight.SemiBold),\n                        color = if (validationResult == true) SuccessEmerald else ErrorCoral\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.weight(1f))\n\n            // Tile Pool (Word Bank) matching screenshot 2 & 3\n            Column(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .padding(horizontal = 16.dp),\n                horizontalAlignment = Alignment.CenterHorizontally\n            ) {\n                FlowRow(\n                    horizontalArrangement = Arrangement.spacedBy(14.dp),\n                    verticalArrangement = Arrangement.spacedBy(14.dp),\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .testTag(\"tile_pool\")\n                ) {\n                    poolTokens.forEachIndexed { index, token ->\n                        WordChip(\n                            text = token,\n                            isPlaced = false,\n                            onClick = {\n                                poolTokens.removeAt(index)\n                                placedTokens.add(token)\n                                validationResult = null\n                                feedbackMessage = \"\"\n                            },\n                            testTag = \"pool_chip_$token\"\n                        )\n                    }\n                }"
